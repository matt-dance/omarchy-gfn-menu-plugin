{
  // Sample Omarchy menu extension for GeForce NOW Menu (matt-dance.gfn-omarchy).
  //
  // IMPORTANT: `omarchy plugin add` does NOT merge this file automatically.
  // Prefer the safe helper after install:
  //   bash scripts/install-menu-extension.sh
  // Or merge these keys by hand into:
  //   ~/.config/omarchy/extensions/omarchy-menu.jsonc
  // then run: omarchy menu refresh
  //
  // Stock Install → Gaming (`install.gaming`) is the *installer* list.
  // This adds a separate root Gaming → GeForce NOW tree for search + launch.

  "gaming": {
    "icon": "",
    "label": "Gaming",
    "description": "Play games, including GeForce NOW cloud titles",
    "aliases": ["games", "gfn", "geforce now"]
  },
  "gaming.geforce-now": {
    "icon": "󰢹",
    "label": "GeForce NOW",
    "description": "NVIDIA GeForce NOW cloud games (GFN)",
    "aliases": ["gfn", "geforce", "nvidia", "cloud gaming"]
  },
  "gaming.geforce-now.search": {
    "icon": "󰍉",
    "label": "Search GeForce NOW",
    "description": "Search the GFN catalog and add a game (plugin: matt-dance.gfn-omarchy)",
    "aliases": ["gfn search", "add a game", "add gfn game", "geforce now search"],
    "action": "omarchy-shell shell summon matt-dance.gfn-omarchy '{}'"
  },
  // gfn-games:start
  // gfn-games:end
  "gaming.geforce-now.remove": {
    "icon": "",
    "label": "Remove a game",
    "description": "Remove a GeForce NOW / GFN menu and Apps entry",
    "aliases": ["gfn remove", "remove gfn", "delete game", "uninstall gfn game"],
    "action": "omarchy-launch-floating-terminal-with-presentation $HOME/.config/omarchy/plugins/matt-dance.gfn-omarchy/scripts/gfn-remove.sh"
  }
}
